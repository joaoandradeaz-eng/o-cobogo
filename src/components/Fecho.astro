---
/**
 * O FECHO — a seção que encerra as páginas do Cobogó: uma banda no bege
 * da marca, tudo centralizado e com respiro. Duas partes separadas por
 * uma listrinha terracota: a conversa (WhatsApp + reações +
 * compartilhar) e a inscrição (e-mail OU WhatsApp). Sem cobogós aqui —
 * a cor é o que diferencia a seção.
 *
 * Nas páginas de artigo (com `slug` e `titulo`) mostra tudo; na home e
 * no arquivo (sem slug) mostra só a inscrição.
 *
 * Mesma trava de sempre: sem armazenamento configurado (dev ou
 * INSCRITOS_GITHUB_TOKEN), não renderiza.
 */
import Reactions from './Reactions.astro';

interface Props {
  /** slug do artigo — liga conversa + reações; sem ele, só inscrição */
  slug?: string;
}
const { slug } = Astro.props;
const ativa = import.meta.env.DEV || !!import.meta.env.INSCRITOS_GITHUB_TOKEN;

// Link puro pro WhatsApp, sem mensagem pré-preenchida: a pessoa escreve do jeito dela.
const waHref = 'https://wa.me/5511993060198';
---

{ativa && (
<section class="fecho" id="fecho" aria-label="Fim da página">
  <div class="miolo">
    {slug ? (
      <>
        <h3 class="titulo">O texto termina aqui. A conversa, não.</h3>
        <p class="fala">Me diz o que este texto te provocou: eu leio e respondo no WhatsApp.</p>
        <div class="acoes">
          <a class="btn btn-fb" href={waHref} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15"><path fill="currentColor" d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.87 9.87 0 0 0 4.74 1.21c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.83 9.83 0 0 0 12.04 2Zm4.52 13.99c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
            Mandar feedback&nbsp;→
          </a>
          <Reactions slug={slug} />
          <button type="button" class="share" data-share>Compartilhar</button>
        </div>
        <div class="listrinha" aria-hidden="true"></div>
      </>
    ) : null}

    <div class="inscricao">
      <p class="receber-t">Quer receber os próximos?</p>
      <p class="receber-s">Deixe seu e-mail ou seu WhatsApp que eu te mando por lá.</p>

      <form id="fecho-form" novalidate>
        <fieldset class="canais">
          <legend class="sr-only">Como você quer receber</legend>
          <label>
            <input type="radio" name="canal" value="email" checked />
            <span>E-mail</span>
          </label>
          <label>
            <input type="radio" name="canal" value="whatsapp" />
            <span>WhatsApp</span>
          </label>
        </fieldset>
        <input
          id="fecho-contato"
          class="campo"
          name="contato"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="seu@email.com"
          aria-label="Seu contato"
          required
        />
        <button type="submit" class="btn btn-ass">Quero receber&nbsp;→</button>
        <!-- honeypot: humano não vê nem preenche -->
        <div class="hp" aria-hidden="true">
          <label>Deixe este campo vazio<input type="text" name="site" tabindex="-1" autocomplete="off" /></label>
        </div>
      </form>
      <p class="erro" role="alert" hidden></p>
      <p class="lgpd">Seu contato fica só comigo e você sai da lista quando quiser.</p>

      <div class="sucesso" hidden tabindex="-1">
        <svg class="check" viewBox="0 0 64 64" aria-hidden="true">
          <circle class="c" cx="32" cy="32" r="29" fill="none" stroke-width="2.5" />
          <path class="v" d="M20 33.5 L28.5 42 L44.5 24" fill="none" stroke-width="4"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div class="ok-txt">
          <p class="ok-titulo">Pronto, você está na lista!</p>
          <p class="ok-sub"></p>
        </div>
      </div>
    </div>
  </div>
</section>
)}

<style>
  .fecho{
    background:var(--paper-2);
    border-top:1px solid var(--rule);
    margin-top:56px;
  }
  .miolo{
    max-width:820px;margin:0 auto;
    padding:76px 28px 72px;
    text-align:center;
  }

  /* ---- conversa ---- */
  .titulo{
    font-family:var(--serif);font-weight:600;
    font-size:clamp(30px,4vw,46px);letter-spacing:-.018em;line-height:1.12;
    color:var(--ink);text-wrap:balance;
  }
  .fala{
    margin-top:16px;font-family:var(--serif);font-style:italic;
    font-size:17.5px;line-height:1.55;color:var(--ink-2);
  }
  .acoes{
    margin-top:30px;
    display:flex;align-items:center;justify-content:center;
    gap:16px;flex-wrap:wrap;
  }
  .btn{
    display:inline-flex;align-items:center;gap:9px;border-radius:2px;
    padding:13px 20px;cursor:pointer;text-decoration:none;
    font-family:var(--mono);font-size:11px;font-weight:600;
    letter-spacing:.13em;text-transform:uppercase;border:1px solid transparent;
    transition:background .2s ease,color .2s ease,border-color .2s ease;
  }
  .btn-fb{background:#25D366;border-color:#25D366;color:#fff}
  .btn-fb:hover{background:#1DA851;border-color:#1DA851}
  .share{
    font-family:var(--mono);font-size:11px;font-weight:600;
    letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);
    text-decoration:underline;text-underline-offset:4px;
    background:none;border:none;cursor:pointer;padding:0;
    transition:color .2s ease;
  }
  .share:hover{color:var(--ink)}

  /* a listrinha: separa a conversa da inscrição */
  .listrinha{
    width:64px;height:3px;background:var(--terra);
    margin:52px auto 48px;border-radius:2px;
  }

  /* ---- inscrição ---- */
  .receber-t{
    font-family:var(--serif);font-weight:600;
    font-size:clamp(24px,2.6vw,30px);letter-spacing:-.014em;color:var(--ink);
  }
  .receber-s{
    margin-top:10px;font-family:var(--serif);font-style:italic;
    font-size:16px;color:var(--ink-2);
  }
  form{
    margin-top:26px;
    display:flex;gap:10px;flex-wrap:wrap;
    align-items:stretch;justify-content:center;
  }
  .canais{
    border:1px solid var(--ink);border-radius:2px;
    display:inline-flex;padding:0;background:#fff;
  }
  .canais label{position:relative;display:block;cursor:pointer}
  .canais input{position:absolute;inset:0;opacity:0;cursor:pointer}
  .canais span{
    display:flex;align-items:center;height:100%;padding:0 16px;
    font-family:var(--mono);font-size:10px;font-weight:600;
    letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);
    transition:background .18s ease,color .18s ease;
  }
  .canais label + label span{border-left:1px solid var(--ink)}
  .canais input:checked + span{background:var(--ink);color:var(--paper)}
  .canais input:focus-visible + span{outline:2px solid var(--terra);outline-offset:3px;border-radius:2px}
  .campo{
    flex:0 1 320px;min-width:220px;
    font-family:var(--serif);font-size:16px;color:var(--ink);
    background:#fff;border:1px solid var(--rule-strong);border-radius:2px;
    padding:13px 15px;
  }
  .campo::placeholder{color:#5A5148;opacity:1}
  .btn-ass{background:var(--ink);border-color:var(--ink);color:var(--paper)}
  .btn-ass:hover{background:var(--terra-deep);border-color:var(--terra-deep)}
  .btn-ass:disabled{opacity:.55;cursor:default}
  .hp{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}
  .sr-only{
    position:absolute;width:1px;height:1px;margin:-1px;padding:0;
    overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;
  }
  .erro{margin-top:14px;font-family:var(--serif);font-size:14.5px;color:var(--terra-deep)}
  .lgpd{
    margin-top:18px;font-family:var(--serif);font-style:italic;
    font-size:13px;color:var(--ink-3);
  }

  /* ---- sucesso ---- */
  .fecho.feita .receber-t,
  .fecho.feita .receber-s{display:none}
  .sucesso{
    display:flex;align-items:center;justify-content:center;
    gap:18px;outline:none;text-align:left;
  }
  .sucesso[hidden]{display:none}
  .check{width:52px;height:52px;flex-shrink:0;color:#2F7D3B}
  .check .c,.check .v{stroke:currentColor}
  .check .c{--traco:183;stroke-dasharray:183;stroke-dashoffset:0}
  .check .v{--traco:37;stroke-dasharray:37;stroke-dashoffset:0}
  .ok-titulo{font-family:var(--serif);font-weight:600;font-size:22px;color:var(--ink)}
  .ok-sub{
    margin-top:4px;font-family:var(--serif);font-style:italic;
    font-size:15px;color:var(--ink-2);
  }
  .fecho.feita .check .c{animation:desenha .55s cubic-bezier(.22,1,.36,1) both}
  .fecho.feita .check .v{animation:desenha .4s cubic-bezier(.22,1,.36,1) .4s both}
  @keyframes desenha{
    from{stroke-dashoffset:var(--traco)}
    to{stroke-dashoffset:0}
  }
  @media (prefers-reduced-motion: reduce){
    .fecho.feita .check .c,
    .fecho.feita .check .v{animation:none}
  }

  @media (max-width:760px){
    .fecho{margin-top:44px}
    .miolo{padding:52px 20px 52px}
    .listrinha{margin:40px auto 36px}
  }
  @media (max-width:560px){
    form .btn-ass{flex:1 1 100%;justify-content:center}
    .sucesso{flex-direction:column;align-items:center;text-align:center}
  }
</style>

<style is:global>
  /* as células de reação dentro do fecho ficam brancas sobre o bege
     (o componente Reactions usa cinza translúcido no resto do site) */
  .fecho .reacoes button{background:var(--paper)}
  .fecho .reacoes button:hover{background:#fff}
  .fecho .reacoes button[aria-pressed="true"]{background:#000}
</style>

<script>
  const fecho = document.getElementById('fecho');
  const form = document.getElementById('fecho-form') as HTMLFormElement | null;

  if (fecho && form) {
    const campo = form.querySelector<HTMLInputElement>('#fecho-contato')!;
    const erro = fecho.querySelector<HTMLParagraphElement>('.erro')!;
    const lgpd = fecho.querySelector<HTMLParagraphElement>('.lgpd')!;
    const botao = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const sucesso = fecho.querySelector<HTMLDivElement>('.sucesso')!;
    const okSub = sucesso.querySelector<HTMLParagraphElement>('.ok-sub')!;

    const ATTRS: Record<string, Record<string, string>> = {
      email: { type: 'email', inputmode: 'email', autocomplete: 'email', placeholder: 'seu@email.com' },
      whatsapp: { type: 'tel', inputmode: 'tel', autocomplete: 'tel-national', placeholder: '(61) 99999-9999' },
    };

    function canalAtual(): string {
      return (form!.querySelector<HTMLInputElement>('input[name=canal]:checked')?.value) || 'email';
    }

    form.querySelectorAll<HTMLInputElement>('input[name=canal]').forEach((r) =>
      r.addEventListener('change', () => {
        const a = ATTRS[canalAtual()];
        Object.entries(a).forEach(([k, v]) => campo.setAttribute(k, v));
        erro.hidden = true;
        campo.focus();
      })
    );

    function valida(canal: string, v: string): string | null {
      if (canal === 'email') {
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()))
          return 'Esse e-mail não parece válido. Confere pra mim?';
      } else {
        const d = v.replace(/\D/g, '');
        if (d.length < 10 || d.length > 13)
          return 'Esse número não parece válido. Use DDD + celular, tipo (61) 99999-9999.';
      }
      return null;
    }

    function mostraSucesso(canal: string, jaExistia: boolean) {
      okSub.textContent = jaExistia
        ? 'Você já estava na lista. Tudo certo, o combinado segue de pé.'
        : canal === 'email'
          ? 'O próximo ensaio chega direto no seu e-mail.'
          : 'O próximo ensaio chega direto no seu WhatsApp.';
      form!.hidden = true;
      lgpd.hidden = true;
      sucesso.hidden = false;
      fecho!.classList.add('feita');
      sucesso.focus({ preventScroll: true });
    }

    // Pré-visualização do estado de sucesso SÓ em dev: /?sucesso
    if (import.meta.env.DEV && new URLSearchParams(location.search).has('sucesso')) {
      mostraSucesso('email', false);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const canal = canalAtual();
      const contato = campo.value;

      const msg = valida(canal, contato);
      if (msg) {
        erro.textContent = msg;
        erro.hidden = false;
        campo.focus();
        return;
      }

      erro.hidden = true;
      botao.disabled = true;
      const rotulo = botao.textContent;
      botao.textContent = 'Enviando…';

      try {
        const res = await fetch('/api/inscrever', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            canal,
            contato,
            origem: location.pathname,
            site: (form.querySelector<HTMLInputElement>('input[name=site]')?.value) || '',
          }),
        });
        const dados = await res.json().catch(() => ({}));

        if (res.ok && dados.ok) {
          mostraSucesso(canal, !!dados.jaExistia);
          (window as any).umami?.track('inscricao', { canal });
        } else {
          erro.textContent = dados.erro || 'Não consegui salvar agora. Tenta de novo?';
          erro.hidden = false;
        }
      } catch {
        erro.textContent = 'Sem conexão agora. Tenta de novo em instantes?';
        erro.hidden = false;
      } finally {
        botao.disabled = false;
        botao.textContent = rotulo;
      }
    });
  }
</script>
