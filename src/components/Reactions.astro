---
/**
 * Reações do artigo (estilo Instagram/WhatsApp): três positivas e
 * diferentes — Adorei, Aplausos, Me fez pensar. Aparece no topo e no fim
 * do artigo; as duas instâncias ficam sincronizadas pelo mesmo script.
 * Contagem global via /api/reacoes; o "já reagi" fica no localStorage.
 *
 * Mesma trava do SubscribeBox: sem armazenamento configurado, não renderiza.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const ativa = import.meta.env.DEV || !!import.meta.env.INSCRITOS_GITHUB_TOKEN;

// Marcas tipográficas próprias (SVG monocromático, na tinta do site) em vez
// de emoji colorido — mais a cara do Cobogó. Sem rótulo visível; o nome fica
// no title/aria pra acessibilidade e tooltip.
// Cada símbolo tem cor própria, sempre visível (com e sem clique):
// coração vermelho, faísca amarelo clarinho, lâmpada âmbar.
const OPCOES = [
  {
    id: 'adorei',
    rotulo: 'Adorei',
    cor: '#C0392B',
    path: 'M12 21s-6.9-4.6-9.4-8.3C.5 9.6 2.2 5.9 5.6 5.9c2 0 3.2 1.1 4 2.3.4.7 1.7.7 2.1 0 .8-1.2 2-2.3 4-2.3 3.4 0 5.1 3.7 3 6.8C18.9 16.4 12 21 12 21z',
  },
  {
    id: 'aplausos',
    rotulo: 'Brilhante',
    cor: '#E6C14A',
    path: 'M12 2l2.3 7.7L22 12l-7.7 2.3L12 22l-2.3-7.7L2 12l7.7-2.3z',
  },
  {
    id: 'pensei',
    rotulo: 'Me fez pensar',
    cor: '#CE8F1F',
    path: 'M12 2.6a6.6 6.6 0 0 0-3.8 12c.7.5 1.1 1.2 1.2 2h5.2c.1-.8.5-1.5 1.2-2a6.6 6.6 0 0 0-3.8-12zM9.6 18.4h4.8v1a1.7 1.7 0 0 1-1.7 1.5h-1.4a1.7 1.7 0 0 1-1.7-1.5z',
  },
];
---

{ativa && (
<div class="reacoes" data-reacoes data-slug={slug} aria-label="Reagir ao texto">
  {OPCOES.map((o) => (
    <button type="button" data-reacao={o.id} aria-pressed="false" aria-label={o.rotulo} title={o.rotulo}>
      <span class="emo" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="17" height="17"><path fill={o.cor} d={o.path} /></svg>
      </span>
      <span class="num" hidden></span>
    </button>
  ))}
</div>
)}

<style>
  .reacoes{display:flex;gap:8px;flex-wrap:wrap}
  /* célula de cobogó: quadradinho cinza bem clarinho, sem borda, só o símbolo */
  .reacoes button{
    display:inline-flex;align-items:center;justify-content:center;gap:7px;
    min-width:40px;height:40px;padding:0 12px;
    font-family:var(--mono);font-size:11px;font-weight:600;
    color:var(--ink-2);
    background:rgba(27,22,18,.05);border:none;
    border-radius:2px;cursor:pointer;
    transition:background .18s ease,color .18s ease;
  }
  .reacoes button:hover{background:rgba(27,22,18,.09);color:#000}
  .reacoes button[aria-pressed="true"]{
    background:#000;color:var(--paper);
  }
  .reacoes .emo{display:flex;line-height:1}
  .reacoes .emo svg{display:block}
  .reacoes .num{font-weight:600}
  .reacoes .num[hidden]{display:none}
  /* pop do emoji ao reagir */
  .reacoes button.pop .emo{animation:pop .45s cubic-bezier(.22,1,.36,1)}
  @keyframes pop{
    0%{transform:scale(1)}
    40%{transform:scale(1.45)}
    100%{transform:scale(1)}
  }
  @media (prefers-reduced-motion: reduce){
    .reacoes button.pop .emo{animation:none}
  }
  @media (max-width:760px){
    .reacoes{gap:8px}
  }
</style>

<script>
  const grupos = Array.from(document.querySelectorAll<HTMLElement>('[data-reacoes]'));

  if (grupos.length) {
    const slug = grupos[0].dataset.slug!;
    const CHAVE = `cobogo-reacoes:${slug}`;

    function minhas(): Set<string> {
      try {
        return new Set(JSON.parse(localStorage.getItem(CHAVE) || '[]'));
      } catch {
        return new Set();
      }
    }
    function guardar(s: Set<string>) {
      try {
        localStorage.setItem(CHAVE, JSON.stringify([...s]));
      } catch {}
    }

    function pintar(contagens: Record<string, number> | null) {
      const feitas = minhas();
      grupos.forEach((g) =>
        g.querySelectorAll<HTMLButtonElement>('button[data-reacao]').forEach((b) => {
          const id = b.dataset.reacao!;
          b.setAttribute('aria-pressed', String(feitas.has(id)));
          if (contagens) {
            const n = contagens[id] ?? 0;
            const num = b.querySelector<HTMLElement>('.num')!;
            num.textContent = String(n);
            num.hidden = n === 0;
          }
        })
      );
    }

    // enquanto houver clique em trânsito, os números do servidor não
    // sobrescrevem o ajuste otimista da tela
    let pendentes = 0;

    // estado local imediato; números globais chegam em seguida
    pintar(null);
    fetch(`/api/reacoes?slug=${encodeURIComponent(slug)}`, { cache: 'no-store' })
      .then((r) => r.json())
      .then((d) => { if (d.ok && pendentes === 0) pintar(d.contagens); })
      .catch(() => {});

    grupos.forEach((g) =>
      g.addEventListener('click', async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-reacao]');
        if (!b) return;
        const id = b.dataset.reacao!;
        const feitas = minhas();
        const removendo = feitas.has(id);
        removendo ? feitas.delete(id) : feitas.add(id);
        guardar(feitas);

        // otimista: ajusta os números na tela antes da resposta
        grupos.forEach((gr) => {
          const num = gr.querySelector<HTMLElement>(`button[data-reacao="${id}"] .num`)!;
          const n = Math.max(0, (parseInt(num.textContent || '0', 10) || 0) + (removendo ? -1 : 1));
          num.textContent = String(n);
          num.hidden = n === 0;
        });
        pintar(null);
        if (!removendo) {
          const alvo = b.querySelector('.emo')!.parentElement!;
          alvo.classList.remove('pop');
          void (alvo as HTMLElement).offsetWidth;
          alvo.classList.add('pop');
          (window as any).umami?.track('reacao', { slug, reacao: id });
        }

        pendentes++;
        try {
          const res = await fetch('/api/reacoes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, reacao: id, delta: removendo ? -1 : 1 }),
          });
          const d = await res.json();
          if (d.ok && pendentes === 1) pintar(d.contagens);
        } catch {} finally {
          pendentes--;
        }
      })
    );
  }
</script>
